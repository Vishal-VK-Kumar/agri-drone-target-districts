# Copy to .env (make does this for you on first run). Local development values only.
POSTGRES_USER=agri
POSTGRES_PASSWORD=agri
POSTGRES_DB=agri
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# postgres (default, needs `make up`) or duckdb (no Docker; single file below)
DB_BACKEND=postgres
DUCKDB_PATH=data/warehouse.duckdb
