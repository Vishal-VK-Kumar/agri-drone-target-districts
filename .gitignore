# Source data is exported by hand from UPAg and is not redistributed here.
# MANIFEST.json is the exception: it is checksums/sizes/row counts, not data.
data/raw/*
!data/raw/MANIFEST.json
data/*.duckdb
data/*.duckdb.wal

# Local secrets and environment
.env
.venv/
__pycache__/
*.pyc

# Results are regenerated, not committed. Two exceptions: output/marts/ is
# the file interface to the Power BI report, and split_artefact_demo.txt is
# evidence referenced directly from the README, not disposable scratch output
output/*
!output/marts/
!output/split_artefact_demo.txt

.DS_Store
